digraph SimpleGym { graph [rankdir=LR, bgcolor="#f8fafc", pad=0.5, nodesep=0.4, ranksep=1, splines=spline, fontname="Arial", fontsize=25, labelloc=t, label="SimpleGym | Esquema relacional MySQL\n19 tabelas - SQL de instalacao\n"]; node [shape=box,style="rounded,filled",fontname="Consolas",fontsize=12,margin=0.18,color="#a3adbd"]; edge [color="#8995a8",arrowsize=0.7];
"usuarios" [fillcolor="#dfeafe",label="usuarios\l-------------------------------------\lPK    id                  INT\l      nome                VARCHAR(80)\l      email               VARCHAR(190)\l      senha_hash          VARCHAR(255)\l      criado_em           TIMESTAMP\l"];
"sessoes_persistentes" [fillcolor="#dfeafe",label="sessoes_persistentes\l-------------------------------------\lPK    seletor             CHAR(24)\lFK    usuario_id          INT\l      token_hash          CHAR(64)\l      expira_em           DATETIME\l"];
"usuarios" -> "sessoes_persistentes";
"tentativas_login" [fillcolor="#dfeafe",label="tentativas_login\l-------------------------------------\lPK    chave               CHAR(64)\l      tentativas          INT\l      inicio              DATETIME\l"];
"perfis_usuario" [fillcolor="#dfeafe",label="perfis_usuario\l-------------------------------------\lPK/FK usuario_id          INT\l      versao              INT\l      xp                  INT\l      dias_seguidos       INT\l      treinos_concluidos  INT\l      minutos_atividade   DOUBLE\l      tema                ENUM\l      atualizado_em       TIMESTAMP\l"];
"usuarios" -> "perfis_usuario";
"grupos_musculares" [fillcolor="#fff0bf",label="grupos_musculares\l-------------------------------------\lPK    id                  VARCHAR(100)\l      nome                VARCHAR(180)\l      descricao           TEXT\l      ordem               INT\l"];
"niveis" [fillcolor="#fff0bf",label="niveis\l-------------------------------------\lPK    nivel               INT\l      xp_minimo           INT\l      titulo              VARCHAR(180)\l      descricao           TEXT\l"];
"exercicios" [fillcolor="#fff0bf",label="exercicios\l-------------------------------------\lPK    id                  BIGINT\lFK    usuario_id          INT ?\l      codigo              VARCHAR(100)\l      nome                VARCHAR(180)\l      foto                MEDIUMTEXT\l      descricao           TEXT\l      execucao            TEXT\l      tipo                ENUM\l      ordem               INT\lG     dono                INT\l"];
"usuarios" -> "exercicios";
"exercicio_grupos" [fillcolor="#fff0bf",label="exercicio_grupos\l-------------------------------------\lPK/FK exercicio_id        BIGINT\lPK/FK grupo_id            VARCHAR(100)\l      ordem               INT\l"];
"exercicios" -> "exercicio_grupos";
"grupos_musculares" -> "exercicio_grupos";
"exercicio_musculos" [fillcolor="#fff0bf",label="exercicio_musculos\l-------------------------------------\lPK/FK exercicio_id        BIGINT\lPK    ordem               INT\l      nome                VARCHAR(200)\l"];
"exercicios" -> "exercicio_musculos";
"treinos" [fillcolor="#daf3e8",label="treinos\l-------------------------------------\lPK    id                  BIGINT\lFK    usuario_id          INT\l      codigo              VARCHAR(100)\l      nome                VARCHAR(180)\l      ordem               INT\l"];
"usuarios" -> "treinos";
"treino_grupos" [fillcolor="#daf3e8",label="treino_grupos\l-------------------------------------\lPK/FK treino_id           BIGINT\lPK    ordem               INT\l      nome                VARCHAR(260)\l"];
"treinos" -> "treino_grupos";
"treino_exercicios" [fillcolor="#daf3e8",label="treino_exercicios\l-------------------------------------\lPK/FK treino_id           BIGINT\lPK    ordem               INT\lFK    exercicio_id        BIGINT\l      series              INT\l      repeticoes          INT\l      carga               DOUBLE\l"];
"treinos" -> "treino_exercicios";
"exercicios" -> "treino_exercicios";
"configuracoes_exercicio" [fillcolor="#daf3e8",label="configuracoes_exercicio\l-------------------------------------\lPK/FK usuario_id          INT\lPK/FK exercicio_id        BIGINT\l      series              INT\l      repeticoes          INT\l      carga               DOUBLE\l"];
"usuarios" -> "configuracoes_exercicio";
"exercicios" -> "configuracoes_exercicio";
"agenda_semanal" [fillcolor="#daf3e8",label="agenda_semanal\l-------------------------------------\lPK/FK usuario_id          INT\lPK    dia                 ENUM\lPK/FK treino_id           BIGINT\l      ordem               INT\l"];
"usuarios" -> "agenda_semanal";
"treinos" -> "agenda_semanal";
"atividades_diarias" [fillcolor="#daf3e8",label="atividades_diarias\l-------------------------------------\lPK/FK usuario_id          INT\lPK    dia                 DATE\lPK    tipo                ENUM\l"];
"usuarios" -> "atividades_diarias";
"treino_sessoes" [fillcolor="#ebe2fa",label="treino_sessoes\l-------------------------------------\lPK/FK usuario_id          INT\l      indice_exercicio    INT\l      series_concluidas   INT\l      pausado             BOOLEAN\l      iniciado_em_ms      BIGINT\l      atividade_ms        DOUBLE\l      concede_xp          BOOLEAN\l"];
"usuarios" -> "treino_sessoes";
"sessao_treinos" [fillcolor="#ebe2fa",label="sessao_treinos\l-------------------------------------\lPK/FK usuario_id          INT\lPK    ordem               INT\l      codigo_treino       VARCHAR(100)\l"];
"treino_sessoes" -> "sessao_treinos";
"sessao_exercicios" [fillcolor="#ebe2fa",label="sessao_exercicios\l-------------------------------------\lPK/FK usuario_id          INT\lPK    ordem               INT\lFK    exercicio_id        BIGINT\l      codigo_treino       VARCHAR(100) ?\l      nome_treino         VARCHAR(180) ?\l      series              INT\l      repeticoes          INT\l      carga               DOUBLE\l"];
"treino_sessoes" -> "sessao_exercicios";
"exercicios" -> "sessao_exercicios";
"aceites_termos" [fillcolor="#dfeafe",label="aceites_termos\l-------------------------------------\lPK/FK usuario_id          INT\lPK    versao              VARCHAR(30)\l      texto               MEDIUMTEXT\l      texto_sha256        CHAR(64)\l      aceito_em           TIMESTAMP\l"];
"usuarios" -> "aceites_termos";
legenda [fillcolor="white",fontname="Arial",label="LEGENDA\lPK: chave primaria | FK: chave estrangeira\lG: coluna gerada | ?: permite NULL\lSeta: tabela referenciada -> tabela com FK\lVarias PK na mesma tabela: chave composta\l\lAzul: conta e seguranca\lAmarelo: catalogo e niveis\lVerde: planejamento e historico\lRoxo: treino em andamento\l\lusuario_id NULL em exercicios: catalogo padrao\lniveis e tentativas_login nao possuem FK\lcodigo_treino nas sessoes: copia sem FK\lTipos resumidos, sem UNSIGNED e valores do ENUM\l"]; }